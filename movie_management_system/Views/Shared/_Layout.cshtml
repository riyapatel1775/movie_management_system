<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Movie Booking System</title>
</head>
<body style="font-family: Arial; margin: 20px;">

    <div>
        <strong>Movie Booking System</strong> |
        @Html.ActionLink("Home", "Index", "Home") |
        @Html.ActionLink("Categories", "Index", "MovieCategory") |
        @Html.ActionLink("Movies", "Index", "Movie") |
        @Html.ActionLink("Search Movies", "Search", "Movie") |
        @Html.ActionLink("Book Movie", "BookMovie", "Booking") |
        @Html.ActionLink("My Bookings", "MyBookings", "Booking") |
        @Html.ActionLink("Profile", "Index", "Profile") |
        @Html.ActionLink("Login", "Login", "Account") |
        @Html.ActionLink("Register", "Register", "Account")
    </div>

    <hr />

    @if (TempData["SuccessMessage"] != null)
    {
        <p style="color: green; font-weight: bold;">@TempData["SuccessMessage"]</p>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <p style="color: red; font-weight: bold;">@TempData["ErrorMessage"]</p>
    }

    @RenderBody()

    <hr style="margin-top: 30px;" />
    <p style="font-size: 12px; color: gray;">&copy; @DateTime.Now.Year - Movie Booking System</p>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    @RenderSection("scripts", required: false)

</body>
</html>
