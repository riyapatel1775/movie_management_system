@model movie_management_system.Models.User

@{
    ViewBag.Title = "User Profile";
}

<h2>User Profile</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)
    @Html.HiddenFor(model => model.User_ID)

    <p>
        User Name:<br />
        @Html.TextBoxFor(model => model.User_Name)<br />
        @Html.ValidationMessageFor(model => model.User_Name)
    </p>

    <p>
        Email ID:<br />
        @Html.TextBoxFor(model => model.Email_ID)<br />
        @Html.ValidationMessageFor(model => model.Email_ID)
    </p>

    <p>
        City:<br />
        @Html.TextBoxFor(model => model.City)<br />
        @Html.ValidationMessageFor(model => model.City)
    </p>

    <p>
        Phone Number:<br />
        @Html.TextBoxFor(model => model.PhoneNo)<br />
        @Html.ValidationMessageFor(model => model.PhoneNo)
    </p>

    <p>
        Password:<br />
        @Html.PasswordFor(model => model.User_password)<br />
        @Html.ValidationMessageFor(model => model.User_password)
    </p>

    <p>
        Confirm Password:<br />
        @Html.PasswordFor(model => model.ConfirmPassword)<br />
        @Html.ValidationMessageFor(model => model.ConfirmPassword)
    </p>

    <p>
        <input type="submit" value="Save Changes" /> |
        @Html.ActionLink("Back to Home", "Index", "Home")
    </p>
}
